<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFloating"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- FLOATING ICON: 44dp, KOTAK HITAM, BORDER MERAH, HURUF X MERAH -->
    <FrameLayout
        android:id="@+id/btnFloatingIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_floating_icon"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:letterSpacing="0.02"
            android:text="X"
            android:textColor="@color/accent_red"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- PANEL MENU: KAPSUL VERTIKAL RAMPING (LEBAR 140dp) -->
    <LinearLayout
        android:id="@+id/panelMenu"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_panel_menu"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnMenuConfig"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="CONFIG"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/glass_border" />

        <TextView
            android:id="@+id/btnMenuHide"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="HIDE"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/glass_border" />

        <TextView
            android:id="@+id/btnMenuExit"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="EXIT"
            android:textColor="@color/accent_red"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
