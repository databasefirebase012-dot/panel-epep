<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootBottomSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- HEADER: TARGET CIRCLE & MODE TOGGLE & CLOSE (X) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvActiveCircleTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.02"
            android:text="TARGET: LINGKARAN 1 (SENSI 0.0 - 10.0)"
            android:textColor="@color/accent_red"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggleMode"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_glass_card"
            android:letterSpacing="0.02"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"
            android:text="MODE: INJEKSI X&amp;Y"
            android:textColor="@color/text_white"
            android:textSize="9sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <FrameLayout
            android:id="@+id/btnCloseConfig"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close_red"
                android:contentDescription="CLOSE" />
        </FrameLayout>
    </LinearLayout>

    <!-- BARIS 1: SLIDER SENSI X & SENSI Y (RANGE: 0.00 - 10.00) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- SENSI X -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLabelSensiX"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="SENSI X: 2.50"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekSensiX"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:max="1000"
                android:progress="250"
                android:progressTint="@color/accent_red"
                android:thumbTint="@color/accent_red" />
        </LinearLayout>

        <!-- SENSI Y -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLabelSensiY"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="SENSI Y: 3.50"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekSensiY"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:max="1000"
                android:progress="350"
                android:progressTint="@color/accent_red"
                android:thumbTint="@color/accent_red" />
        </LinearLayout>
    </LinearLayout>

    <!-- BARIS 2: SLIDER RADIUS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLabelRadius"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="RADIUS: 45 DP"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekRadius"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:max="90"
                android:progress="35"
                android:progressTint="@color/accent_red"
                android:thumbTint="@color/accent_red" />
        </LinearLayout>
    </LinearLayout>

    <!-- BARIS 3: ACTION BUTTONS (ADD, DELETE, CANCEL, SAVE) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- ADD BUTTON -->
        <Button
            android:id="@+id/btnAddCircle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_glass_card"
            android:letterSpacing="0.02"
            android:padding="0dp"
            android:text="+ ADD"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <!-- DELETE BUTTON -->
        <Button
            android:id="@+id/btnDeleteCircle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_glass_card"
            android:letterSpacing="0.02"
            android:padding="0dp"
            android:text="DELETE"
            android:textColor="@color/accent_red"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <!-- CANCEL BUTTON -->
        <Button
            android:id="@+id/btnCancelConfig"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_glass_card"
            android:letterSpacing="0.02"
            android:padding="0dp"
            android:text="CANCEL"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <!-- SAVE BUTTON (RED) -->
        <Button
            android:id="@+id/btnSaveConfig"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:background="@drawable/bg_btn_red"
            android:letterSpacing="0.02"
            android:padding="0dp"
            android:text="SAVE"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
