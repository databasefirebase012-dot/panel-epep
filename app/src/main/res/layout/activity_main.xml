<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_doff"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- HEADER: LOGO & APP TITLE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_floating_icon"
            android:padding="6dp"
            android:src="@drawable/ic_hypnos_logo"
            android:contentDescription="HYPNOS LOGO" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="HYPNOS"
                android:textColor="@color/text_white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="TOUCH OPTIMIZER &amp; PELICIN LAYAR"
                android:textColor="@color/accent_red"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- PID MONITORING BOX -->
    <LinearLayout
        android:id="@+id/boxPid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:text="SHIZUKU CORE (UID 2000)"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPidStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.02"
            android:text="TERPUTUS"
            android:textColor="@color/text_dim"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvShizukuHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.02"
            android:text="TAP UNTUK MENGHUBUNGKAN SHIZUKU"
            android:textColor="@color/accent_red"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SYSTEM PERMISSIONS BOX (ALERT WINDOW & WRITE SETTINGS) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:text="STATUS PERMISSION"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- ROW 1: ALERT WINDOW -->
        <LinearLayout
            android:id="@+id/rowPermOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.02"
                android:text="WINDOW ALERT (OVERLAY)"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="BELUM DIAKTIFKAN"
                android:textColor="@color/accent_red"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ROW 2: WRITE SETTINGS -->
        <LinearLayout
            android:id="@+id/rowPermWriteSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.02"
                android:text="WRITE SETTINGS (PELICIN)"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusWriteSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="BELUM DIAKTIFKAN"
                android:textColor="@color/accent_red"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- SECTION TITLE: GAME TARGET -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.02"
        android:text="TARGET GAME"
        android:textColor="@color/text_white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <!-- GAME CARDS (FF MAX & FF ORIGINAL) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <!-- FF MAX CARD -->
        <LinearLayout
            android:id="@+id/cardFfMax"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/imgFfMaxIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_cross_dim"
                android:contentDescription="FF MAX ICON" />

            <TextView
                android:id="@+id/tvFfMaxName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.02"
                android:text="FF MAX"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFfMaxStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.02"
                android:text="TIDAK TERPASANG"
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- FF ORIGINAL CARD -->
        <LinearLayout
            android:id="@+id/cardFfOriginal"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/imgFfOriginalIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_cross_dim"
                android:contentDescription="FF ORIGINAL ICON" />

            <TextView
                android:id="@+id/tvFfOriginalName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.02"
                android:text="FF ORIGINAL"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFfOriginalStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.02"
                android:text="TIDAK TERPASANG"
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- START BUTTON -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_btn_red"
        android:enabled="false"
        android:letterSpacing="0.02"
        android:text="START"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
